# --- Server ---
PORT=3000

# --- First admin (used only when the users table is empty on boot) ---
# Set these before the first start, then you may remove them.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately

# --- Data ---
# Directory holding xcmediapass.db and uploads/. Defaults to ./data
# DATA_DIR=./data

# --- Frontend build-time keys (Vite reads these at `npm run build`) ---
VITE_TMDB_API_KEY=

# --- Notes ---
# API keys / tokens stored in entity records (e.g. MediaServer api_key,
# DiscordBotConfig tokens) are stored as provided in the SQLite database.
# Protect the database file and its backups accordingly: restrict filesystem
# permissions on ./data and encrypt off-site backups.
