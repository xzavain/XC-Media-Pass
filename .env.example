# XC Media Pass environment template — copy to .env and fill in.
#   cp .env.example .env
#
# In Coolify, paste these into the service's Environment Variables instead.
# NOTE: VITE_TMDB_API_KEY is read at *build* time (npm run build inside the
# Docker build). In Coolify, set it as a build argument / build-time variable
# so the frontend bakes it in; the rest are runtime variables.

# REQUIRED — first admin account, created automatically on first boot
# (only when the users table is empty). Change after first login; the
# variables are ignored once any user exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately

# OPTIONAL — TMDB discovery layer (build-time). Leave empty to disable.
VITE_TMDB_API_KEY=

# OPTIONAL — port the app listens on inside the container (default 3000).
# Only change if you map a different host port in docker-compose.yml.
PORT=3000

# OPTIONAL — outbound email (campaigns, release notifications, password
# reset links). Without SMTP_HOST, email features report "not configured"
# honestly in the UI, and password reset links are written to the server
# log instead of being emailed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=XC Media Pass

# OPTIONAL — public base URL of this instance (used to build password
# reset links). Leave unset to derive it from the request (works behind
# Coolify's proxy); set it if links come out with the wrong host.
# APP_BASE_URL=https://mediapass.example.com

# OPTIONAL — data directory override. Defaults to ./data (mounted at /app/data).
# DATA_DIR=./data

# --- Notes ---
# API keys / tokens stored in entity records (e.g. MediaServer api_key,
# DiscordBotConfig tokens) are stored as provided in the SQLite database.
# Protect the database file and its backups: restrict filesystem permissions
# on the data volume and encrypt off-site backups.
