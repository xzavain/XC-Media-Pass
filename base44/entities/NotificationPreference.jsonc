{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email_enabled": {
      "type": "boolean",
      "default": true
    },
    "user_email": {
      "type": "string"
    },
    "browser_push_enabled": {
      "type": "boolean",
      "default": false
    },
    "push_subscription_data": {
      "type": "object"
    },
    "discord_notifications_enabled": {
      "type": "boolean",
      "default": false
    },
    "discord_user_id": {
      "type": "string",
      "description": "Discord user ID for pinging/mentioning user in channel alerts"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}