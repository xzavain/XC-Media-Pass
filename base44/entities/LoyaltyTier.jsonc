{
  "name": "LoyaltyTier",
  "type": "object",
  "properties": {
    "tier_name": {
      "type": "string",
      "description": "Bronze Pioneer, Silver Streamer, Gold Cinephile, Platinum Edge Host, Obsidian VIP"
    },
    "tier_rank": {
      "type": "number",
      "default": 0
    },
    "min_active_months": {
      "type": "number",
      "default": 0
    },
    "min_successful_referrals": {
      "type": "number",
      "default": 0
    },
    "perk_summary": {
      "type": "string"
    },
    "badge_icon_asset": {
      "type": "string",
      "description": "SVG / PNG badge URL"
    },
    "discord_role_id": {
      "type": "string"
    },
    "discord_role_name": {
      "type": "string"
    },
    "gradient_colors": {
      "type": "string",
      "description": "CSS gradient string for tier badge styling"
    },
    "discord_bot_token": {
      "type": "string",
      "description": "Global Discord bot token (stored on rank 0 tier)"
    },
    "discord_guild_id": {
      "type": "string",
      "description": "Global Discord guild ID (stored on rank 0 tier)"
    }
  },
  "required": [
    "tier_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}