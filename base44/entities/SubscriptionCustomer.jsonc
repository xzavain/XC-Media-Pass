{
  "name": "SubscriptionCustomer",
  "type": "object",
  "properties": {
    "gateway_account_id": {
      "type": "string",
      "description": "Reference to PaymentGatewayAccount"
    },
    "external_customer_id": {
      "type": "string",
      "description": "Stripe cus_xxx or PayPal customer id"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}