{
  "name": "UserWatchlist",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "media_release_id": {
      "type": "string",
      "description": "Reference to MediaRelease"
    },
    "notify_theatrical": {
      "type": "boolean",
      "default": false
    },
    "notify_digital_vod": {
      "type": "boolean",
      "default": true
    },
    "notify_server_import": {
      "type": "boolean",
      "default": true
    },
    "sync_plex": {
      "type": "boolean",
      "default": true
    },
    "sync_emby": {
      "type": "boolean",
      "default": true
    },
    "sync_jellyfin": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id",
    "media_release_id"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}